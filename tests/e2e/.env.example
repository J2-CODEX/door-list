# Copy to tests/e2e/.env.local (ignored by git). Never commit credentials.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_ORGANIZER_EMAIL=
E2E_ORGANIZER_PASSWORD=
MAILOSAUR_SERVER_ID=
MAILOSAUR_API_KEY=
# Set to 1 only after explicit authorization to access the chosen test database.
RUN_E2E_DB_TESTS=0
# Cover integration: configure only after selecting and authorizing a test project.
E2E_TEST_PROJECT_REF=
E2E_OTHER_ORGANIZER_EMAIL=
E2E_OTHER_ORGANIZER_PASSWORD=
# SUPABASE_SECRET_KEY belongs only in server/test secret configuration.
# Legacy SUPABASE_SERVICE_ROLE_KEY remains supported as a fallback.
